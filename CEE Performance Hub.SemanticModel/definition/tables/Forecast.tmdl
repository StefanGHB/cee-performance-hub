/// ETS statistical forecast with 80%/95% prediction intervals (back-test + forward).
table Forecast
	lineageTag: 591f4f00-3986-4905-89d4-692edee65f44

	column Month
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: ebdf1916-509f-444e-9f61-93db717eca59
		sourceColumn: Month

	column 'Country Code'
		dataType: string
		isHidden
		lineageTag: 43e387a0-816a-4f9f-9d4f-bf0e435f08f8
		sourceColumn: Country Code

	column 'Category ID'
		dataType: string
		isHidden
		lineageTag: d46bfbaa-80a0-496b-97a1-0a35a5258c5a
