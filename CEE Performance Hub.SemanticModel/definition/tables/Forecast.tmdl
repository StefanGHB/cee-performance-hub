	column 'Forecast Type'
		dataType: string
		isHidden
		lineageTag: 90da28b2-5c58-4fe1-8f8e-83d0592d8d34
		sourceColumn: Forecast Type

	column 'Forecast EUR'
		dataType: double
		isHidden
		formatString: #,0
