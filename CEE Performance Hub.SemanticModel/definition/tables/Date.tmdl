	/// Year > Quarter > Month > Date drill-down.
	hierarchy Calendar
		lineageTag: 88f75f05-91e1-49c6-b133-a4f0826afb31

		level Year
			lineageTag: f0a0aac6-4230-46e0-a496-fe0cbbdae4ea
