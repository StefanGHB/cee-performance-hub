/// Calendar 2023-2027. Reporting cut-off (last closed month): 30 Sep 2026.
table Date
	lineageTag: 51e368c2-e3cc-44a0-bbdd-fed80cbc513a
	dataCategory: Time

	column Date
		dataType: dateTime
		isUnique
		isKey
		formatString: dd mmm yyyy
		lineageTag: c9bb998f-8e3d-4b85-8db2-d90db9e74187
		sourceColumn: Date

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 999ec613-657f-480d-8a26-052964c485d3
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 118ccb64-bcb3-413a-ae18-0255bb29b6fa
		sourceColumn: Quarter

	column 'Year Quarter'
		dataType: string
		lineageTag: 97fb36db-daff-4924-beef-e4ec1f94fd68
		sourceColumn: Year Quarter
		sortByColumn: 'Year Quarter Sort'

	column 'Year Quarter Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c5b9ccde-434f-4a39-b4f4-bb201292b6b0
		summarizeBy: none
		sourceColumn: Year Quarter Sort

	column 'Month No'
		dataType: int64
		formatString: #,0
		lineageTag: d0ef26e1-5c9f-4a08-b597-db3e24514d01
		summarizeBy: none
		sourceColumn: Month No

	column Month
		dataType: string
		lineageTag: 16723b5e-4f18-4a32-837b-4e8adda53b66
