		sourceColumn: Weekday
		sortByColumn: 'Weekday No'

	column 'Weekday No'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: af9d5b2c-6136-45f6-853f-8dbbef427923
		summarizeBy: none
		sourceColumn: Weekday No

	column 'Is Weekend'
		dataType: boolean
		lineageTag: e7c31123-59fc-426d-8479-531008224633
		sourceColumn: Is Weekend

	column 'Is Actual Period'
		dataType: boolean
		isHidden
		lineageTag: a8ea5f31-8b10-485c-b9fa-328d4ba4a415
