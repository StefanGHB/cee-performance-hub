		level Month
			lineageTag: 1b3ce37f-6718-4f49-a005-9e8993ade58a
			column: 'Year Month'

		level Date
			lineageTag: b5faf9d7-9c05-48d7-b8ef-731749fd5022
			column: Date

	partition Date = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "dim_date.parquet"))
				in
				    Source

