		sortByColumn: 'Month No'

	column 'Month Short'
		dataType: string
		lineageTag: e9b91def-0e75-4bb4-ab53-3e13182bde91
		sourceColumn: Month Short
		sortByColumn: 'Month No'

	column 'Year Month'
		dataType: string
		lineageTag: 407fc164-4567-45f5-a35d-e4e2d5898584
		sourceColumn: Year Month
		sortByColumn: 'Year Month Sort'

	column 'Year Month Sort'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 385f09b6-f1b5-4d1f-b9a2-6eda29543c39
		summarizeBy: none
		sourceColumn: Year Month Sort

	column 'Month Start'
		dataType: dateTime
		formatString: dd mmm yyyy
		lineageTag: c7666049-a0a3-4ba0-bf2b-37fcdb324324
		sourceColumn: Month Start

	column 'ISO Week'
		dataType: int64
		formatString: #,0
		lineageTag: 5615a71b-a525-4b76-aa77-094461423a51
		summarizeBy: none
		sourceColumn: ISO Week

	column Weekday
		dataType: string
